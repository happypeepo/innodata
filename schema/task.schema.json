{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "One line of tasks.jsonl (B -> C), contract v1",
  "description": "Image paths are relative to the data folder. reference uses the same keys as parsed answers; choice/sequence/set answers are option letters.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "scene_id", "family", "images", "question", "answer_type", "answer_format",
               "reference", "checker", "evidence", "validated", "difficulty"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^t_[0-9]{6}_F(10|[1-9])_[0-9]{2}$"},
    "scene_id": {"type": "string", "pattern": "^s_[0-9]{6}[a-z]?$"},
    "family": {"enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10"]},
    "images": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "pattern": "^images/[^/]+\\.png$"}},
    "question": {"type": "string", "minLength": 1},
    "answer_type": {"enum": ["point", "bbox", "count", "choice", "bool", "sequence", "set"]},
    "answer_format": {"type": "string", "minLength": 1},
    "reference": {"type": "object"},
    "checker": {"enum": ["point_in_mask", "point_in_any_mask", "bbox_iou", "exact", "topo_order_valid", "set_f1"]},
    "evidence": {"type": "array", "items": {"oneOf": [{"type": "string", "pattern": "^o[0-9]+$"}, {"const": "table"}]}},
    "validated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unique_referent", "min_visible", "margin_ok", "human"],
      "properties": {
        "unique_referent": {"type": ["boolean", "null"]},
        "min_visible": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 1}]},
        "margin_ok": {"type": ["boolean", "null"]},
        "human": {"type": ["boolean", "null"]}
      }
    },
    "difficulty": {
      "type": "object",
      "required": ["n_objects", "occlusion", "distractors"],
      "properties": {
        "n_objects": {"type": "integer", "minimum": 1, "maximum": 20},
        "occlusion": {"type": "number", "minimum": 0, "maximum": 1},
        "distractors": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"answer_type": {"const": "point"}}},
     "then": {"properties": {"checker": {"enum": ["point_in_mask", "point_in_any_mask"]},
                             "reference": {"$ref": "#/$defs/ref_point"}}}},
    {"if": {"properties": {"answer_type": {"const": "bbox"}}},
     "then": {"properties": {"checker": {"const": "bbox_iou"}, "reference": {"$ref": "#/$defs/ref_bbox"}}}},
    {"if": {"properties": {"answer_type": {"const": "count"}}},
     "then": {"properties": {"checker": {"const": "exact"}, "reference": {"$ref": "#/$defs/ref_count"}}}},
    {"if": {"properties": {"answer_type": {"const": "choice"}}},
     "then": {"properties": {"checker": {"const": "exact"}, "reference": {"$ref": "#/$defs/ref_choice"}}}},
    {"if": {"properties": {"answer_type": {"const": "bool"}}},
     "then": {"properties": {"checker": {"const": "exact"}, "reference": {"$ref": "#/$defs/ref_bool"}}}},
    {"if": {"properties": {"answer_type": {"const": "sequence"}}},
     "then": {"properties": {"checker": {"const": "topo_order_valid"}, "reference": {"$ref": "#/$defs/ref_sequence"}}}},
    {"if": {"properties": {"answer_type": {"const": "set"}}},
     "then": {"properties": {"checker": {"const": "set_f1"}, "reference": {"$ref": "#/$defs/ref_set"}}}}
  ],
  "$defs": {
    "letter": {"type": "string", "pattern": "^[A-Z]$"},
    "seg_ids": {"type": "array", "items": {"type": "integer", "minimum": 2, "maximum": 255}, "minItems": 1, "uniqueItems": true},
    "options": {
      "type": "object", "minProperties": 2,
      "propertyNames": {"pattern": "^[A-Z]$"},
      "additionalProperties": {"type": "string", "minLength": 1},
      "description": "Letter -> object id (or \"table\", or an answer word such as \"in front of\")."
    },
    "ref_point": {
      "type": "object", "additionalProperties": false, "required": ["seg_ids"],
      "properties": {"seg_ids": {"$ref": "#/$defs/seg_ids"}}
    },
    "ref_bbox": {
      "type": "object", "additionalProperties": false, "required": ["bbox", "seg_ids"],
      "properties": {
        "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "seg_ids": {"$ref": "#/$defs/seg_ids"}
      }
    },
    "ref_count": {
      "type": "object", "additionalProperties": false, "required": ["count"],
      "properties": {"count": {"type": "integer", "minimum": 0}}
    },
    "ref_choice": {
      "type": "object", "additionalProperties": false, "required": ["choice", "options"],
      "properties": {"choice": {"$ref": "#/$defs/letter"}, "options": {"$ref": "#/$defs/options"}}
    },
    "ref_bool": {
      "type": "object", "additionalProperties": false, "required": ["bool"],
      "properties": {"bool": {"type": "boolean"}}
    },
    "ref_sequence": {
      "type": "object", "additionalProperties": false, "required": ["sequence", "options", "precedes"],
      "properties": {
        "sequence": {"type": "array", "items": {"$ref": "#/$defs/letter"}, "minItems": 1, "uniqueItems": true,
                     "description": "One valid order (example). Any order that respects precedes is correct."},
        "options": {"$ref": "#/$defs/options"},
        "precedes": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/letter"}, "minItems": 2, "maxItems": 2},
                     "description": "[a, b] = a must come before b."}
      }
    },
    "ref_set": {
      "type": "object", "additionalProperties": false, "required": ["set", "options"],
      "properties": {
        "set": {"type": "array", "items": {"$ref": "#/$defs/letter"}, "uniqueItems": true},
        "options": {"$ref": "#/$defs/options"}
      }
    }
  }
}
